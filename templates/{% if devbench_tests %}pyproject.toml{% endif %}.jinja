[project]
name = "{{ project_name | lower }}-tests"
version = "0.1.0"
requires-python = ">=3.11"

[dependency-groups]
dev = [
    "modorganizer-plugin-kit[test] @ git+https://github.com/gabriel-andreescu/ModOrganizerPluginKit.git#subdirectory=python",
    "ruff>=0.16.7",
]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
target-version = "py311"
extend-exclude = ["scratch"]

[tool.ruff.lint]
extend-select = ["I"]
