name: Build and release

on:
  push:
    branches: [main]
    tags: ["v[0-9]*", "[0-9]*"]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  build:
    permissions:
      contents: write
    uses: {{ mopk_repository | regex_replace('^https?://[^/]+/', '') }}/.github/workflows/build.yml@v{{ mopk_version }}
